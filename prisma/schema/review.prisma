model Review{
    id String @id @default(uuid())
    userId String
    technicianId String
    bookingId String
    serviceId String
    rating Float
    comment String @db.VarChar(300)

    service Service @relation(fields: [serviceId], references: [id], onDelete: Cascade)
    user User @relation(fields: [userId], references: [id], onDelete: Cascade)
    
    
}